# Systemd service file for AeroSync Django application
# Place this file in /etc/systemd/system/aerosync.service

[Unit]
Description=AeroSync Backend (Daphne + Cloudflare Tunnel)
After=network.target

[Service]
Type=simple
User=nixii
Group=nixii
WorkingDirectory=/home/nixii/Documents/aerosync/aerosync-backend
Environment=PATH=/home/nixii/Documents/aerosync/aerosync-backend/venv/bin
Environment=DJANGO_DEBUG=0
Environment=SERVE_MEDIA_FROM_DJANGO=1
ExecStart=/home/nixii/Documents/aerosync/aerosync-backend/start.sh
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target