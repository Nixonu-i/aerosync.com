# Local development environment variables for AeroSync frontend
# Vite will proxy /api/ requests to http://localhost:8000 via the vite.config.js proxy setting

# API base URL - relative path means vite proxy handles it in dev
VITE_API_URL=/api/

# If you plan to open the frontend over HTTPS (e.g. via ngrok), set:
# VITE_HTTPS=true

# Environment indicator
VITE_ENV=development
