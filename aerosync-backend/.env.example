# Pesapal Payment Gateway Configuration
# Get these credentials from https://developer.pesapal.com/

# Sandbox (Testing) Credentials
PESAPAL_CONSUMER_KEY=your_sandbox_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_sandbox_secret_here
PESAPAL_ENVIRONMENT=sandbox

# Production Credentials (uncomment when ready for live payments)
# PESAPAL_CONSUMER_KEY=your_production_consumer_key_here
# PESAPAL_CONSUMER_SECRET=your_production_secret_here
# PESAPAL_ENVIRONMENT=production

# Callback URLs (must be publicly accessible)
# For local development with Cloudflare tunnel:
PESAPAL_CALLBACK_URL=https://api.aerosync.live/api/payments/pesapal/callback/
PESAPAL_IPN_URL=https://api.aerosync.live/api/payments/pesapal/ipn/

# For local testing without tunnel (use ngrok or similar):
# PESAPAL_CALLBACK_URL=http://your-ngrok-url.ngrok.io/api/payments/pesapal/callback/
# PESAPAL_IPN_URL=http://your-ngrok-url.ngrok.io/api/payments/pesapal/ipn/
